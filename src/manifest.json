{
  "manifest_version": 3,
  "name": "TabHarbor",
  "version": "0.3.0",
  "description": "窗口/分组/标签三层树，拖拽整理、搜索、浏览器实时同步，侧边栏/独立窗口/置顶小窗一致体验",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "contextMenus",
    "alarms",
    "commands",
    "downloads",
    "geolocation"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://wallhaven.cc/*",
    "https://w.wallhaven.cc/*",
    "https://nekos.best/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabHarbor",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "commands": {
    "open-side": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "打开侧边栏"
    },
    "open-window": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "打开独立窗口"
    },
    "locate-tab": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "定位当前标签"
    },
    "expand-all": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "展开全部"
    },
    "collapse-all": {
      "description": "收起全部（未预置快捷键，可在 chrome://extensions/shortcuts 自行绑定）"
    }
  }
}
