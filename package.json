{
  "name": "tabharbor",
  "version": "0.3.0-preview.1",
  "private": true,
  "type": "module",
  "description": "TabHarbor v2 — Chrome MV3 标签管理扩展（窗口/分组/标签三层树，严格实时同步；TDD+BDD 闭环）",
  "scripts": {
    "test": "node tools/bdd-runner.mjs features && node samples/validate-samples.mjs",
    "test:samples": "node samples/validate-samples.mjs",
    "test:e2e": "node tests/e2e-chromium.mjs",
    "constraints": "node tools/check-constraints.mjs",
    "compliance": "node tools/check-compliance.mjs",
    "committer": "node tools/check-committer.mjs",
    "contrast": "node tools/contrast-check.mjs src/assets/m2.css",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.js\" \"tools/*.mjs\" \"tests/*.mjs\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.js\" \"tools/*.mjs\" \"tests/*.mjs\""
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "prettier": "^3.3.3"
  }
}
